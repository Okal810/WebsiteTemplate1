# Environment Configuration Template
# Copy to .env and fill in your values

# Flask Secret Key (generate with: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=change-me-in-production

# Salt for IP address hashing (generate with: python -c "import secrets; print(secrets.token_hex(16))")
IP_HASH_SALT=change-me-in-production

# Discord Webhook URL for notifications (optional)
DISCORD_WEBHOOK_URL=

# Redis URL (optional - uncomment in docker-compose.yml to enable)
# REDIS_URL=redis://redis:6379/0

# Docker Hub credentials (for CI/CD)
# DOCKER_USERNAME=
# DOCKER_PASSWORD=

# Deployment server (for CI/CD)
# DEPLOY_HOST=
# DEPLOY_USER=
# DEPLOY_KEY=
